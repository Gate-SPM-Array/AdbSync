<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>adbsync-cli</AssemblyName>
    <RootNamespace>AdbSync.Cli</RootNamespace>
    <Version>0.1.8</Version>
    <Product>AdbSync</Product>
    <Company>DGR – ICT GRC Consulting</Company>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AdbSync.Core\AdbSync.Core.csproj" />
  </ItemGroup>

  <!-- file di lingua esterni, modificabili: copiati in lang\ accanto all'eseguibile -->
  <ItemGroup>
    <None Include="..\..\lang\*.json" Link="lang\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
